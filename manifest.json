{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "version": "1.2.0",
  "key": "",
  "description": "A beautiful bookmark manager inspired by Raindrop.io. Save, organize, and search your bookmarks with collections and tags.",
  "permissions": [
    "storage",
    "tabs",
    "bookmarks",
    "contextMenus",
    "sidePanel",
    "alarms",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "action": {
    "default_title": "Bookmark Manager",
    "default_popup": "index.html",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html?target=dashboard"
  },
  "omnibox": {
    "keyword": "bm"
  },
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Save current tab to Bookmark Manager"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open Bookmark Manager dashboard"
    }
  }
}
